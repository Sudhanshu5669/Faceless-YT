# Godot
godot/.godot/
*.translation

# Generated output (renders, previews, episodes' heavy media)
output/
episodes/*/renders/
episodes/*/preview/
episodes/*/final/
episodes/*/build/
# Review media is regenerated; the decisions and Claude's suggestions are the record.
episodes/*/review/*
!episodes/*/review/decisions.json
!episodes/*/review/suggestions.json

# Local machine config and secrets (API keys)
config.local.json
.env

# Forced-alignment model (378 MB): models/alignment/, see docs/AUDIO_SPEC.md
models/

# Python
__pycache__/
*.pyc
.venv/

# Raw downloaded asset packs (imported copies live in library/)
incoming/

# Imported asset packs: rebuild with `python pipeline/tf.py assets import`
godot/assets/
library/thumbs/
