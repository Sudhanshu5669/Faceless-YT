## Kits: curated mappings from roles (house, tree, car...) to catalog models.
## library/catalog.json is generated by tools/catalog.gd (sizes, paths);
## library/kits/<id>.json is hand-curated (which models play which role).
extends RefCounted

const Paths = preload("res://scripts/core/paths.gd")

const SEASONS := ["summer", "autumn", "winter", "dead", "dead_winter"]

static var _catalog: Dictionary = {}
static var _kits: Dictionary = {}
static var _scenes: Dictionary = {}
static var _parts: Dictionary = {}


static func catalog() -> Dictionary:
	if _catalog.is_empty():
		var r := Paths.load_json(Paths.repo_path("library/catalog.json"))
		if r["ok"]:
			for m in r["data"]["models"]:
				_catalog[m["id"]] = m
	return _catalog


static func model(id: String) -> Dictionary:
	return catalog().get(id, {})


static func list_kits() -> PackedStringArray:
	return Paths.list_json("library/kits")


## Returns the kit dictionary, or {} if missing.
static func kit(id: String) -> Dictionary:
	if not _kits.has(id):
		var r := Paths.load_json(Paths.repo_path("library/kits/%s.json" % id))
		_kits[id] = r["data"] if r["ok"] else {}
	return _kits[id]


## Every model id a kit references must exist in the catalog.
static func validate_kit(id: String) -> Array:
	var k := kit(id)
	if k.is_empty():
		return ["unknown kit '%s' (available: primitive, %s)" % [id, ", ".join(list_kits())]]
	if catalog().is_empty():
		return ["library/catalog.json is missing: run `python pipeline/tf.py assets catalog`"]
	var e := []
	for mid in _all_ids(k):
		if model(mid).is_empty():
			e.append("kit '%s' references unknown model '%s'" % [id, mid])
	return e


static func _all_ids(v) -> Array:
	var out := []
	match typeof(v):
		TYPE_STRING:
			if String(v).contains("/"):
				out.append(v)
		TYPE_ARRAY:
			for x in v:
				out.append_array(_all_ids(x))
		TYPE_DICTIONARY:
			for k in v:
				if not (k in ["atlas", "roof_colors", "recolor", "description", "credits", "door_materials"]):
					out.append_array(_all_ids(v[k]))
	return out


static func scene(id: String) -> PackedScene:
	if not _scenes.has(id):
		var m := model(id)
		_scenes[id] = load(m["path"]) if not m.is_empty() else null
	return _scenes[id]


## Static mesh parts of a model, for MultiMesh: [{"mesh": Mesh, "xf": Transform3D}].
## Transforms are normalised so the model's footprint is centred at the origin
## and its lowest point sits at y = 0.
static func parts(id: String) -> Array:
	if _parts.has(id):
		return _parts[id]
	var out := []
	var ps := scene(id)
	if ps:
		var inst := _only_node(ps.instantiate(), String(model(id).get("node", "")))
		_collect(inst, Transform3D.IDENTITY, out)
		inst.free()
		var fix := Transform3D(Basis(), -ground_offset(id))
		for p in out:
			p["xf"] = fix * p["xf"]
	_parts[id] = out
	return out


static func _collect(n: Node, xf: Transform3D, out: Array) -> void:
	var t := xf
	if n is Node3D:
		t = xf * (n as Node3D).transform
	if n is MeshInstance3D and (n as MeshInstance3D).mesh:
		out.append({"mesh": (n as MeshInstance3D).mesh, "xf": t})
	for c in n.get_children():
		_collect(c, t, out)


## For models split out of a multi-prop file ("node" in the catalog): drop the
## other root nodes so only this prop remains.
static func _only_node(inst: Node, node: String) -> Node:
	if node == "":
		return inst
	for c in inst.get_children():
		if String(c.name) != node:
			inst.remove_child(c)
			c.free()
	return inst


## Offset that moves the model's footprint centre to the origin and its base to y = 0.
static func ground_offset(id: String) -> Vector3:
	var m := model(id)
	if m.is_empty():
		return Vector3.ZERO
	var mn: Array = m["min"]
	var sz: Array = m["size"]
	return Vector3(float(mn[0]) + float(sz[0]) / 2.0, float(mn[1]), float(mn[2]) + float(sz[2]) / 2.0)


static func size(id: String) -> Vector3:
	var m := model(id)
	if m.is_empty():
		return Vector3.ONE
	return Vector3(m["size"][0], m["size"][1], m["size"][2])


## A static model as plain MeshInstance3D nodes built from parts() (meshes are
## shared, no scene instancing), normalised and scaled. recolor maps flat
## albedo colours ("c65016") to new hex colours; matching surfaces get a
## cached recoloured material.
static func static_node(id: String, scale: float = 1.0, recolor: Dictionary = {}) -> Node3D:
	var root := Node3D.new()
	for p in parts(id):
		var mi := MeshInstance3D.new()
		mi.mesh = p["mesh"]
		mi.transform = p["xf"]
		root.add_child(mi)
		if not recolor.is_empty():
			for s in mi.mesh.get_surface_count():
				var m := _recolored(mi.mesh.surface_get_material(s), recolor)
				if m:
					mi.set_surface_override_material(s, m)
	root.scale = Vector3.ONE * scale
	return root


static var _recolors: Dictionary = {}


static func _recolored(src: Material, recolor: Dictionary) -> Material:
	var bm := src as BaseMaterial3D
	if bm == null:
		return null
	var hex := bm.albedo_color.to_html(false)
	if not recolor.has(hex):
		return null
	var key := "%d|%s" % [src.get_instance_id(), recolor[hex]]
	if not _recolors.has(key):
		var m: BaseMaterial3D = bm.duplicate()
		m.albedo_color = Color(String(recolor[hex]))
		_recolors[key] = m
	return _recolors[key]


## Override every surface whose material is named in names (resource_name) with mat.
static func override_named(node: Node, names: Array, mat: Material) -> void:
	if node is MeshInstance3D and (node as MeshInstance3D).mesh:
		var mi := node as MeshInstance3D
		for s in mi.mesh.get_surface_count():
			var m := mi.mesh.surface_get_material(s)
			if m and String(m.resource_name) in names:
				mi.set_surface_override_material(s, mat)
	for c in node.get_children():
		override_named(c, names, mat)


## A placed instance of a model, normalised (footprint centred, base at y=0), scaled.
static func instance(id: String, scale: float) -> Node3D:
	var ps := scene(id)
	var root := Node3D.new()
	if ps == null:
		return root
	var offset := Node3D.new()
	offset.position = -ground_offset(id)
	offset.add_child(_only_node(ps.instantiate(), String(model(id).get("node", ""))))
	root.add_child(offset)
	root.scale = Vector3.ONE * scale
	return root
