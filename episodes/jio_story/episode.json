 "lines": [
  {
   "id": "n1a",
   "text": "Imagine you're Mukesh Ambani.",
   "shot": "open",
   "at": 0.1
  },
  {
   "id": "n1b",
   "text": "You run refineries, petrol and plastics.",
   "shot": "empire_items",
   "at": 0.1
  },
  {
   "id": "n1c",
   "text": "But you lost the one business your father dreamed about.",
   "shot": "lost",
   "at": 0.1
  },
  {
   "id": "n2",
   "text": "In 2002, your father Dhirubhai wanted a phone call to cost less than a postcard.",
   "shot": "tribute",
   "at": 0.1
  },
  {
   "id": "n3a",
   "text": "Then the family empire splits.",
   "shot": "split",
   "at": 0.1
  },
  {
   "id": "n3b",
   "text": "Your brother Anil gets the phone company,",
   "shot": "anil_phone",
   "at": 0.1
  },
  {
   "id": "n3c",
   "text": "and you agree to stay out of telecom.",
   "shot": "no_telecom",
   "at": 0.1
  },
  {
   "id": "n4",
   "text": "So you watch.",
   "shot": "watch",
   "at": 0.1
  },
  {
   "id": "n5a",
   "text": "In 2015, most Indians are online on slow 2G.",
   "shot": "street_2g",
   "at": 0.1
  },
  {
   "id": "n5b",
   "text": "One gigabyte costs about 250 rupees,",
   "shot": "price",
   "at": 0.1
  },
  {
   "id": "n5c",
   "text": "and every video buffers forever.",
   "shot": "buffer",
   "at": 0.1
  }
 ],
