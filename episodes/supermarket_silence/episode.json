{
  "schema_version": "0.1",
  "id": "supermarket_silence",
  "title": "A Toy Starts Talking. They Heard It.",
  "description": "Pitch C: stuck in a supermarket at 3 AM with sound-sensitive zombies outside; a toy in aisle 6 starts talking.",
  "set": "specs/sets/freshway.json",
  "format": {
    "resolution": [
      1080,
