    "speed": 1.22
  },
  "lines": [
    {
      "id": "toy1",
      "text": "Let's play!",
      "voice": "Leda",
      "style": "cheerful, bright, sing-song toy voice",
      "fx": "toy",
      "shot": "toy_wakes",
      "at": 0.35,
      "speed": 1.0
    },
    {
      "id": "n1",
      "text": "Three A.M. Aisle six. And a toy just said: let's play.",
      "shot": "horde_turns",
      "at": 0.2
    },
    {
      "id": "n2",
      "text": "They're blind. They hunt by sound. And between you and three hundred of them... there's only glass.",
      "shot": "glass_wall",
      "at": 0.15
    },
    {
      "id": "n3",
      "text": "The toy is forty meters away. On this tile, every step is a gunshot.",
      "shot": "long_aisle",
      "at": 0.15
    },
    {
      "id": "n4",
      "text": "So you take off your shoes.",
      "shot": "shoes",
      "at": 0.15
    },
    {
      "id": "toy2",
      "text": "Let's play!",
      "voice": "Leda",
      "style": "cheerful, bright, sing-song toy voice",
      "fx": "toy",
      "shot": "toy_again",
      "at": 0.2,
      "speed": 1.0
    },
    {
      "id": "n5a",
      "text": "Aisle four. Aisle five.",
      "shot": "sneak",
      "at": 0.2
    },
    {
      "id": "n5b",
      "text": "Behind you... the glass starts to creak.",
      "shot": "creak",
      "at": 0.1
    },
    {
      "id": "n6",
      "text": "Aisle six. You grab it, flip it over... and pull the batteries.",
      "shot": "reach",
      "at": 0.15
    },
    {
      "id": "n7",
      "text": "Silence.",
      "shot": "silence",
      "at": 0.5
    },
    {
      "id": "n8",
      "text": "Seven hours. That's how long you've survived in here. Seven hours of perfect silence.",
      "shot": "seven_hours",
      "at": 0.3
    },
    {
      "id": "toy3",
      "text": "Let's play!",
      "voice": "Leda",
      "style": "cheerful, bright, sing-song toy voice",
      "fx": "toy_chorus",
      "shot": "all_toys",
      "at": 0.25,
      "gain": 2,
      "speed": 1.0
    },
    {
      "id": "n9",
      "text": "You'd survive seven hours. The toys had other plans.",
      "shot": "ending",
      "at": 0.4
    }
  ],
