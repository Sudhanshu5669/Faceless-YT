 "sfx": [],
 "lines": [
  {
   "id": "h1",
   "shot": "hall_wide",
   "at": 0.3,
   "text": "July 2024. Hall H, San Diego Comic-Con.",
   "style": "serious"
  },
  {
   "id": "h2",
   "shot": "hall_walk",
   "at": 0.1,
   "text": "More than six thousand fans watch a line of masked men in green cloaks walk onto the stage.",
   "style": "whispers"
  },
  {
   "id": "h3",
   "shot": "hall_unmask",
   "at": 0.15,
   "text": "Then one of them takes off his mask.",
   "style": "tense"
  },
  {
   "id": "h4",
   "shot": "hall_reveal",
   "at": 0.05,
   "text": "It's Robert Downey Junior. Iron Man himself.",
   "style": "excited"
  },
  {
   "id": "h5",
   "shot": "hall_quote",
   "at": 0.1,
   "text": "And he tells the crowd: new mask, same task.",
   "style": "mischievously"
  },
  {
   "id": "v1",
   "shot": "lab_machine",
   "at": 0.3,
   "text": "At Empire State University, Victor builds a machine to reach the realm of the dead, and speak to his mother.",
   "style": "serious"
  },
  {
   "id": "v2",
   "shot": "lab_warning",
   "at": 0.05,
   "text": "His classmate, Reed Richards, spots a flaw in the calculations.",
   "style": "tense"
  },
  {
   "id": "v3",
   "shot": "lab_ignore",
   "at": 0.05,
   "text": "Victor ignores him.",
   "style": "deadpan"
  },
  {
   "id": "v4",
   "shot": "lab_blast",
   "at": 0.05,
   "text": "The machine explodes in his face.",
   "style": "shouting"
  },
  {
   "id": "k1",
   "shot": "board_plan",
   "at": 0.3,
   "text": "Marvel had built its next saga around one villain: Kang.",
   "style": "serious"
  },
  {
   "id": "k2",
   "shot": "board_news",
   "at": 0.05,
   "text": "Then, in December 2023, the actor who played him was convicted of assault and harassment.",
   "style": "serious"
  },
  {
   "id": "k3",
   "shot": "board_collapse",
   "at": 0.05,
   "text": "Marvel dropped him the same day. And the whole plan came down.",
   "style": "sighs"
  }
 ],
