  "single_take": true,
  "style": "gripping true-story narrator for a YouTube Short, telling a heist: brisk, confident and a little sly, conspiratorial and hushed in the secret night work, tense while the team waits on the wind, then proud and punchy at the announcement",
  "speed": 1.0
 },
 "captions": {
  "enabled": true,
  "max_words": 2,
